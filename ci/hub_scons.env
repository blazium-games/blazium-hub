# Hub-minimal SCons flags (sourced by CI).
# Philosophy: modules_enabled_by_default=no + explicit allowlist only.
# Never flip back to modules_enabled_by_default=yes.
#
# Editor builds: use HUB_SCONS_COMMON (disable_3d / disable_advanced_gui forbidden on editor).
# template_release: use HUB_SCONS_COMMON + HUB_SCONS_TEMPLATE (adds disable_3d=yes hub_build=yes).
#
# Disabled by default (do not re-enable): gltf fbx csg gridmap jolt godot_physics_*
# navigation openxr webxr mobile_vr camera raycast lightmapper meshoptimizer mono luau
# remote_control justamcp steam discord audio codecs websocket webrtc enet multiplayer
# upnp sqlite jsonrpc zip jpg webp ktx hdr etc. — see plan Hub capability budget.

# Editor: lto=none (MSVC LTCG blows past LNK1248 4GB on editor.lib).
# Template: lto=full in HUB_SCONS_TEMPLATE (not thin — needs LLVM).
HUB_SCONS_COMMON="modules_enabled_by_default=no deprecated=no minizip=no tests=no debug_symbols=no optimize=size lto=none vulkan=no d3d12=no openxr=no opengl3=yes module_mono_enabled=no module_luau_module_enabled=no module_gdscript_enabled=yes module_freetype_enabled=yes module_text_server_fb_enabled=yes module_text_server_adv_enabled=no module_svg_enabled=yes module_mbedtls_enabled=yes module_regex_enabled=yes"

# Appended only for target=template_release (shipped Hub binary).
HUB_SCONS_TEMPLATE="disable_3d=yes lto=full hub_build=yes"

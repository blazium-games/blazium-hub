#!/bin/sh
set -e
BLAZIUM_ROOT=/opt/blazium
mkdir -p "$BLAZIUM_ROOT/bin"
# Ensure blazium → blazium-cli (nfpm may pack a copy; force symlink).
if [ -f "$BLAZIUM_ROOT/bin/blazium-cli" ]; then
  ln -sfn blazium-cli "$BLAZIUM_ROOT/bin/blazium"
fi
ln -sfn "$BLAZIUM_ROOT/bin/blazium-hub" /usr/bin/blazium-hub
ln -sfn "$BLAZIUM_ROOT/bin/blazium-cli" /usr/bin/blazium-cli
ln -sfn "$BLAZIUM_ROOT/bin/blazium" /usr/bin/blazium
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi
if command -v xdg-mime >/dev/null 2>&1; then
  # CLI owns blazium://; Hub desktop is for launching the GUI only.
  xdg-mime default blazium-uri.desktop x-scheme-handler/blazium || true
fi
# Machine-wide Hub remote secret (idempotent; never rotates a valid token).
# || true: headless ensure must not fail package configure.
mkdir -p /etc/blazium
if [ -x "$BLAZIUM_ROOT/bin/blazium-hub" ]; then
  "$BLAZIUM_ROOT/bin/blazium-hub" --headless --ensure-hub-remote \
    --hub-remote-path=/etc/blazium/hub_remote.json --quit || true
elif [ -x "$BLAZIUM_ROOT/bin/blazium-cli" ]; then
  "$BLAZIUM_ROOT/bin/blazium-cli" hub-remote ensure --path /etc/blazium/hub_remote.json || true
fi
# Optional toolchain manager via CDN. Default dpkg install is unchanged.
if [ "${BLAZIUM_INSTALL_TOOLCHAIN:-}" = "1" ] && [ -x "$BLAZIUM_ROOT/bin/blazium-cli" ]; then
  "$BLAZIUM_ROOT/bin/blazium-cli" update apply --product toolchain --install-root "$BLAZIUM_ROOT" || true
  if [ -x "$BLAZIUM_ROOT/bin/blazium-toolchain" ]; then
    ln -sfn "$BLAZIUM_ROOT/bin/blazium-toolchain" /usr/bin/blazium-toolchain
  fi
fi
exit 0

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gdscript/settings_view.gd" id="1"]

[node name="SettingsView" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Settings"

[node name="CliRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="CliLabel" type="Label" parent="CliRow"]
layout_mode = 2
custom_minimum_size = Vector2(160, 0)
text = "blazium-cli path"

[node name="CliPathEdit" type="LineEdit" parent="CliRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Auto-detect from PATH"

[node name="BrowseCliBtn" type="Button" parent="CliRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Browse"

[node name="InstallRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="InstallLabel" type="Label" parent="InstallRow"]
layout_mode = 2
custom_minimum_size = Vector2(160, 0)
text = "Editor install path"

[node name="InstallPathEdit" type="LineEdit" parent="InstallRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="SetInstallPathBtn" type="Button" parent="InstallRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Apply"

[node name="CloseToTrayCheck" type="CheckBox" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Close window to system tray (Windows)"

[node name="CheckUpgradeBtn" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Check blazium-cli updates"

[node name="UriHelp" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
text = "URI scheme: blazium://open?path=…  ·  blazium://load?path=…  ·  blazium://install?version=…  ·  blazium://hub"

[node name="SettingsStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = ""

[node name="CliFileDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Select blazium-cli"
access = 2
use_native_dialog = true
file_mode = 0
